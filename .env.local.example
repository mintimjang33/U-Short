# 이 파일을 복사해서 .env.local로 이름 바꾸고 실제 값을 채워넣으세요.
# .env.local은 git에 올라가지 않습니다 (.gitignore 처리됨).

# ── Supabase (필수) ──────────────────────────────
# Supabase에서 기존 계정으로 New Project 하나 만든 뒤 Project Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── 대본 생성 AI / 음성(TTS) 키 ──────────────────────
# 아래 키들은 이 파일에 안 넣어도 됨 — Supabase app_config 테이블에 한 번 저장해두면
# lib/remoteConfig.js가 파이프라인 시작할 때 자동으로 불러온다(재배포/재설정 불필요).
# 새 컴퓨터에서 시작할 때도 위 Supabase 값 2개만 있으면 나머지는 DB에서 따라온다.
# 로컬에서 잠깐 다른 키로 테스트하고 싶을 때만 여기 채우면 그 값이 우선 적용된다.
#
# SCRIPT_PROVIDER=claude          # claude / gemini / gpt
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
#
# TTS_PROVIDER=fal                # fal / elevenlabs / clova
# FAL_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# NAVER_CLOVA_CLIENT_ID=
# NAVER_CLOVA_CLIENT_SECRET=
