# 이 파일을 복사해서 .env.local로 이름 바꾸고 실제 값을 채워넣으세요.
# .env.local은 git에 올라가지 않습니다 (.gitignore 처리됨).

# ── Supabase (필수) ──────────────────────────────
# Supabase에서 기존 계정으로 New Project 하나 만든 뒤 Project Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── 대본 생성 AI (SCRIPT_PROVIDER로 택1: claude / gemini / gpt) ──
SCRIPT_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── 음성(TTS) (TTS_PROVIDER로 택1: fal / elevenlabs / clova) ──
# 기본값은 fal — 이미 FAL_KEY가 있으면 이것만 채우면 됨
TTS_PROVIDER=fal
FAL_KEY=

# ElevenLabs를 쓸 경우 (무료 티어로 연습하기 좋음)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Naver CLOVA Voice를 쓸 경우 (월 9만원 고정비 — 대량 운영 아니면 비추천)
NAVER_CLOVA_CLIENT_ID=
NAVER_CLOVA_CLIENT_SECRET=
